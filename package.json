{
  "name": "ergomania-event",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
    "build": "vite build",
    "buildStaging": "vite build --mode staging",
    "buildProd": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "preinstall": "npx only-allow pnpm",
    "update:ui-kit": "pnpm update @ergodot/ui-kit"
  },
  "devDependencies": {
    "@ergodot/ui-kit": "npm:@veresdaniel/ui-kit@^1.14.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/postcss": "4.3.2",
    "autoprefixer": "10.5.2",
    "cross-env": "10.1.0",
    "postcss": "8.5.19",
    "postcss-load-config": "6.0.1",
    "sass-embedded": "1.100.0",
    "svelte": "5.56.3",
    "svelte-check": "4.7.2",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "siema": "1.5.1",
    "tailwindcss": "4.3.2"
  },
  "packageManager": "pnpm@11.18.0"
}